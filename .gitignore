# ---- Rendered config that embeds credentials ----
# run-lab-7.sh renders docker/prometheus/prometheus.yml into this file with your
# VCI_ID and WARPSTREAM_APP_KEY substituted in, hence we ignore it to prevent accidental committing of it 
